# Main database (development). Local embedded Postgres: npm run db:start
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/retails_dev
# Database used only by tests (never point at real data)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54329/retails_test
# Better Auth secret, at least 32 characters
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-chars-or-more
# Public base URL of the app
APP_URL=http://localhost:3000
