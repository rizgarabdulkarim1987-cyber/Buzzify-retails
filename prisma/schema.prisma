generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Currency {
  IQD
  USD
}

enum RtBusinessStatus {
  SETUP
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum RtActivityType {
  MARKET
  CLOTHING
  ELECTRONICS
  BEAUTY
  STATIONERY
  MIXED
}

model RtBusiness {
  id                String           @id @default(cuid())
  name              String
  activityType      RtActivityType
  status            RtBusinessStatus @default(SETUP)
  timezone          String           @default("Asia/Baghdad")
  defaultCurrency   Currency
  enabledCurrencies Currency[]
  version           Int              @default(1)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  branches  RtBranch[]
  locations RtLocation[]
  terminals RtTerminal[]
  staff     RtStaff[]

  subscriptions    RtSubscription[]
  subscriptionLog  RtSubscriptionEvent[]
  subscriptionPays RtSubscriptionPayment[]
  featureOverrides RtFeatureOverride[]
}

model RtBranch {
  id         String   @id @default(cuid())
  businessId String
  name       String
  active     Boolean  @default(true)
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business  RtBusiness      @relation(fields: [businessId], references: [id])
  locations RtLocation[]
  terminals RtTerminal[]
  staff     RtStaffBranch[]

  // Target of the composite foreign keys that keep child rows inside one business.
  @@unique([businessId, id])
}

model RtLocation {
  id         String   @id @default(cuid())
  businessId String
  branchId   String
  name       String
  sellable   Boolean  @default(true)
  central    Boolean  @default(false)
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business  RtBusiness   @relation(fields: [businessId], references: [id])
  branch    RtBranch     @relation(fields: [businessId, branchId], references: [businessId, id])
  terminals RtTerminal[]

  // Target of the terminal's composite foreign key (same business AND same branch).
  @@unique([businessId, branchId, id])
}

model RtTerminal {
  id         String   @id @default(cuid())
  businessId String
  branchId   String
  locationId String
  name       String
  active     Boolean  @default(true)
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business RtBusiness @relation(fields: [businessId], references: [id])
  branch   RtBranch   @relation(fields: [businessId, branchId], references: [businessId, id])
  location RtLocation @relation(fields: [businessId, branchId, locationId], references: [businessId, branchId, id])
}

enum RtRole {
  OWNER
  MANAGER
  CASHIER
  STOCK
  PURCHASING
  ACCOUNTANT
  AUDITOR
}

model RtStaff {
  id            String    @id @default(cuid())
  businessId    String
  userId        String
  role          RtRole
  deactivatedAt DateTime?
  version       Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business RtBusiness      @relation(fields: [businessId], references: [id])
  user     User            @relation(fields: [userId], references: [id])
  branches RtStaffBranch[]

  @@unique([businessId, userId])
  // Target of RtStaffBranch's composite foreign key (staff stays in the same business).
  @@unique([businessId, id])
}

model RtStaffBranch {
  staffId    String
  businessId String
  branchId   String

  staff  RtStaff  @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Cascade)
  branch RtBranch @relation(fields: [businessId, branchId], references: [businessId, id])

  @@id([staffId, branchId])
}

// Better Auth tables (email + password, sessions).
model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  staff    RtStaff[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Action framework tables. Neither has a (non-null) businessId column, so both are classified
// in scoped-db.ts (UNSCOPED / NULLABLE_BUSINESS) and only the framework touches them.
model RtIdempotency {
  id          String   @id @default(cuid())
  // The businessId, or the literal 'platform' for platform-level actions.
  scope       String
  key         String
  payloadHash String
  result      Json
  createdAt   DateTime @default(now())

  @@unique([scope, key])
}

model RtAuditLog {
  id         String   @id @default(cuid())
  businessId String?
  actorId    String
  action     String
  entity     String
  entityId   String
  changes    Json
  at         DateTime @default(now())

  @@index([businessId, at])
  @@index([entity, entityId])
}

// Buzzify's own subscription tables. Platform-managed: no tenant action touches them (classified
// UNSCOPED in scoped-db.ts although most carry a businessId), and kept apart from any shop sales tables.
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  GRACE
  EXPIRED
  CANCELLED
}

enum SubscriptionPaymentMethod {
  CASH
  BANK_TRANSFER
  ZAINCASH
  FIB
  QI_CARD
  OTHER
}

model RtPlan {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  maxBranches  Int
  maxTerminals Int
  maxUsers     Int
  storageMb    Int
  aiMonthly    Int
  active       Boolean  @default(true)
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions RtSubscription[]
}

// At most one live (TRIAL, ACTIVE, GRACE) subscription per business: a partial unique index in the migration.
model RtSubscription {
  id                 String             @id @default(cuid())
  businessId         String
  planCode           String
  status             SubscriptionStatus
  trialEndsAt        DateTime?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  graceDays          Int                @default(7)
  cancelledAt        DateTime?
  version            Int                @default(1)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  business RtBusiness              @relation(fields: [businessId], references: [id])
  plan     RtPlan                  @relation(fields: [planCode], references: [code])
  events   RtSubscriptionEvent[]
  payments RtSubscriptionPayment[]

  @@index([businessId, createdAt])
}

model RtSubscriptionEvent {
  id             String              @id @default(cuid())
  subscriptionId String
  businessId     String
  type           String
  fromStatus     SubscriptionStatus?
  toStatus       SubscriptionStatus
  actorId        String?
  occurredAt     DateTime            @default(now())
  // Metadata only: never card, account or personal data.
  data           Json

  subscription RtSubscription @relation(fields: [subscriptionId], references: [id])
  business     RtBusiness     @relation(fields: [businessId], references: [id])

  @@index([subscriptionId, occurredAt])
}

model RtSubscriptionPayment {
  id             String                    @id @default(cuid())
  businessId     String
  subscriptionId String
  amountMinor    BigInt
  currency       Currency
  method         SubscriptionPaymentMethod
  reference      String
  paidAt         DateTime
  coversFrom     DateTime
  coversTo       DateTime
  idempotencyKey String                    @unique
  recordedById   String
  note           String
  createdAt      DateTime                  @default(now())

  business     RtBusiness     @relation(fields: [businessId], references: [id])
  subscription RtSubscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId, paidAt])
}

// A platform admin's manual grant or removal of a feature for one business. The reason is mandatory
// (at least 10 characters, a CHECK constraint in the migration).
model RtFeatureOverride {
  id          String   @id @default(cuid())
  businessId  String
  feature     String
  enabled     Boolean
  reason      String
  grantedById String
  createdAt   DateTime @default(now())

  business RtBusiness @relation(fields: [businessId], references: [id])

  @@index([businessId, feature])
}
