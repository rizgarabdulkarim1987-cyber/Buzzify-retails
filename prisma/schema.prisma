generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Currency {
  IQD
  USD
}

enum RtBusinessStatus {
  SETUP
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum RtActivityType {
  MARKET
  CLOTHING
  ELECTRONICS
  BEAUTY
  STATIONERY
  MIXED
}

model RtBusiness {
  id                String           @id @default(cuid())
  name              String
  activityType      RtActivityType
  status            RtBusinessStatus @default(SETUP)
  timezone          String           @default("Asia/Baghdad")
  defaultCurrency   Currency
  enabledCurrencies Currency[]
  version           Int              @default(1)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  branches  RtBranch[]
  locations RtLocation[]
  terminals RtTerminal[]
  staff     RtStaff[]
}

model RtBranch {
  id         String   @id @default(cuid())
  businessId String
  name       String
  active     Boolean  @default(true)
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business  RtBusiness   @relation(fields: [businessId], references: [id])
  locations RtLocation[]
  terminals RtTerminal[]
  staff     RtStaffBranch[]

  // Target of the composite foreign keys that keep child rows inside one business.
  @@unique([businessId, id])
}

model RtLocation {
  id         String   @id @default(cuid())
  businessId String
  branchId   String
  name       String
  sellable   Boolean  @default(true)
  central    Boolean  @default(false)
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business  RtBusiness   @relation(fields: [businessId], references: [id])
  branch    RtBranch     @relation(fields: [businessId, branchId], references: [businessId, id])
  terminals RtTerminal[]

  // Target of the terminal's composite foreign key (same business AND same branch).
  @@unique([businessId, branchId, id])
}

model RtTerminal {
  id         String   @id @default(cuid())
  businessId String
  branchId   String
  locationId String
  name       String
  active     Boolean  @default(true)
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business RtBusiness @relation(fields: [businessId], references: [id])
  branch   RtBranch   @relation(fields: [businessId, branchId], references: [businessId, id])
  location RtLocation @relation(fields: [businessId, branchId, locationId], references: [businessId, branchId, id])
}

enum RtRole {
  OWNER
  MANAGER
  CASHIER
  STOCK
  PURCHASING
  ACCOUNTANT
  AUDITOR
}

model RtStaff {
  id            String    @id @default(cuid())
  businessId    String
  userId        String
  role          RtRole
  deactivatedAt DateTime?
  version       Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business RtBusiness       @relation(fields: [businessId], references: [id])
  user     User             @relation(fields: [userId], references: [id])
  branches RtStaffBranch[]

  @@unique([businessId, userId])
  // Target of RtStaffBranch's composite foreign key (staff stays in the same business).
  @@unique([businessId, id])
}

model RtStaffBranch {
  staffId    String
  businessId String
  branchId   String

  staff  RtStaff  @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Cascade)
  branch RtBranch @relation(fields: [businessId, branchId], references: [businessId, id])

  @@id([staffId, branchId])
}

// Better Auth tables (email + password, sessions).
model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  staff    RtStaff[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Action framework tables. Neither has a (non-null) businessId column, so both are classified
// in scoped-db.ts (UNSCOPED / NULLABLE_BUSINESS) and only the framework touches them.
model RtIdempotency {
  id          String   @id @default(cuid())
  // The businessId, or the literal 'platform' for platform-level actions.
  scope       String
  key         String
  payloadHash String
  result      Json
  createdAt   DateTime @default(now())

  @@unique([scope, key])
}

model RtAuditLog {
  id         String   @id @default(cuid())
  businessId String?
  actorId    String
  action     String
  entity     String
  entityId   String
  changes    Json
  at         DateTime @default(now())

  @@index([businessId, at])
  @@index([entity, entityId])
}
